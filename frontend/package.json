{
  "name": "aura-frontend",
  "author": "MD Faysal Ahmed Bhuiyan",
  "version": "0.1.2",
  "description": "AURA Personal AI Operating System — Desktop Frontend",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "oxlint ."
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.0.0",
    "vite": "^8.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aura.desktop",
    "productName": "AURA",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!venv",
          "!.venv",
          "!models/sd/**",
          "!models/piper/**"
        ]
      },
      {
        "from": "../models",
        "to": "models",
        "filter": [
          "en_US-lessac-medium.onnx",
          "en_US-lessac-medium.onnx.json",
          "aura-brain.modelfile"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
