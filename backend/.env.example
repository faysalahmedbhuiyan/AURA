# AURA Backend Configuration
# Copy this file to .env and fill in the values

# Server
APP_NAME=AURA
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Database
SQLITE_DB_PATH=../database/aura.db
CHROMA_DB_PATH=../database/chroma